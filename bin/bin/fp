#!/bin/bash

project=$(find ~/source -maxdepth 3 -name .git -type d |\
          sed 's/\/.git//g' |\
          fzf --reverse --preview-window="right:60%" --preview="bat {}/README.md")

if [ -z "$project" ]; then
	echo "You need to select a project."
else
	name=$(basename "$project")
	cd "$project"

	# The VMM holds the lock of a running VM. Starting it again with mounts
	# is refused, so only run with the start flags when it is stopped.
	if ! lsof -t "${VM_HOME:-$HOME/.vm}/vms/$name/lock" >/dev/null 2>&1; then
		# Hardware is fixed when the VM is created, so only a new VM gets it.
		create="--persist --memory 6144"
		vm ls | grep -qx "$name" && create=
		vm run "$name" $create --mount "$project:$name" --wait-network || exit 1
	fi

	printf '\e]2;%s\a' "$name"
	# Ghostty opens new splits and tabs here, so they are host shells in the project.
	printf '\e]7;file://%s%s\a' "$(hostname)" "$project"
	# The VM's tmux session "main", shared with the web UI; it outlives this client.
	exec vm run "$name" -- bash -lc "cd $(printf %q "$name") && exec tmux new-session -A -s main"
fi
