#!/bin/bash

project=$(find ~/source -maxdepth 3 -name .git -type d |\
          sed 's/\/.git//g' |\
          fzf --reverse --preview-window="right:60%" --preview="bat {}/README.md")

if [ -z "$project" ]; then
	echo "You need to select a project."
else
	name=$(basename "$project")
	cd $project

	if ! tmux has-session -t "$name" 2>/dev/null; then
		if varmint ls | grep -qx "$name"; then
			varmint run "$name" --wait-network || exit 1
		else
			varmint run "$name" --persist --mount "$project:work" --wait-network || exit 1
		fi
		tmux new-session -d -s "$name" -c "$project" \
			"varmint exec $name -- bash -lc 'cd work && exec bash -l'; varmint stop $name"
	fi

	if [ -z "$TMUX" ]; then
		tmux attach -t $name
	else
		tmux switch-client -t $name
	fi
fi
